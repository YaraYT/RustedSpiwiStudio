<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RustedShpizhionStudio.App">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#101318" />
      <Setter Property="Foreground" Value="#E8EBF0" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#1A1F27" />
      <Setter Property="BorderBrush" Value="#2A313D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.panel-soft">
      <Setter Property="Background" Value="#171B22" />
      <Setter Property="BorderBrush" Value="#272E39" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8F98A8" />
    </Style>
    <Style Selector="TextBlock.kicker">
      <Setter Property="Foreground" Value="#8D97A8" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2F6FED" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#3B7BFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#3978F2" />
      <Setter Property="Opacity" Value="0.96" />
    </Style>
    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="#275FCF" />
      <Setter Property="Opacity" Value="0.92" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#202630" />
      <Setter Property="Foreground" Value="#D9DEE7" />
      <Setter Property="BorderBrush" Value="#323B49" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="#27303C" />
      <Setter Property="BorderBrush" Value="#414C5C" />
    </Style>
    <Style Selector="Button.secondary:pressed">
      <Setter Property="Background" Value="#1C222B" />
      <Setter Property="Opacity" Value="0.94" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#6A2A33" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#8A3B47" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Button.danger:pointerover">
      <Setter Property="Background" Value="#78323C" />
    </Style>
    <Style Selector="Button.version-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#6685A8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="16" />
    </Style>
    <Style Selector="Button.version-link:pointerover">
      <Setter Property="Foreground" Value="#86B9ED" />
    </Style>
    <Style Selector="Button.gallery-card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.gallery-card:pointerover">
      <Setter Property="Opacity" Value="0.94" />
    </Style>
    <Style Selector="Button.gallery-card:pressed">
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="TextBox.search-box">
      <Setter Property="Background" Value="#11151B" />
      <Setter Property="BorderBrush" Value="#2D3542" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="TextBox.search-box:focus">
      <Setter Property="BorderBrush" Value="#4A79AF" />
    </Style>
  </Application.Styles>
</Application>
