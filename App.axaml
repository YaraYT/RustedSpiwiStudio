<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RustedShpizhionStudio.App">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="#0F1217" />
      <Setter Property="Foreground" Value="#E8EBF0" />
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#171B22" />
      <Setter Property="BorderBrush" Value="#252C37" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.panel-soft">
      <Setter Property="Background" Value="#141820" />
      <Setter Property="BorderBrush" Value="#222934" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Border.card-surface">
      <Setter Property="Background" Value="#171C24" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.gallery-card:pointerover Border.card-surface">
      <Setter Property="Background" Value="#1D2430" />
      <Setter Property="BorderBrush" Value="#344153" />
    </Style>
    <Style Selector="Button.gallery-card:pressed Border.card-surface">
      <Setter Property="Background" Value="#202A38" />
      <Setter Property="BorderBrush" Value="#3E4D63" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8F98A8" />
    </Style>
    <Style Selector="TextBlock.kicker">
      <Setter Property="Foreground" Value="#7E889A" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#3478F6" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#4A87FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#4184F8" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#1B212A" />
      <Setter Property="Foreground" Value="#D9DEE7" />
      <Setter Property="BorderBrush" Value="#2B3441" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="#232B37" />
      <Setter Property="BorderBrush" Value="#3C4859" />
    </Style>
    <Style Selector="Button.icon-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#B9C1CE" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="MinWidth" Value="38" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="Button.icon-button:pointerover">
      <Setter Property="Background" Value="#202733" />
      <Setter Property="Foreground" Value="#F0F3F7" />
    </Style>
    <Style Selector="Button.danger-outline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E88A95" />
      <Setter Property="BorderBrush" Value="#7A3A43" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Button.danger-outline:pointerover">
      <Setter Property="Background" Value="#2A1A1F" />
      <Setter Property="BorderBrush" Value="#A94D59" />
    </Style>
    <Style Selector="Button.version-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#6685A8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="16" />
    </Style>
    <Style Selector="Button.version-link:pointerover">
      <Setter Property="Foreground" Value="#86B9ED" />
    </Style>
    <Style Selector="Button.gallery-card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.gallery-card:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.gallery-card:pressed">
      <Setter Property="Opacity" Value="0.97" />
    </Style>

    <Style Selector="TextBox.search-box">
      <Setter Property="Background" Value="#11151C" />
      <Setter Property="BorderBrush" Value="#2A3441" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBox.search-box:focus">
      <Setter Property="BorderBrush" Value="#4A79AF" />
      <Setter Property="Background" Value="#151B24" />
    </Style>

    <Style Selector="Border.resource-badge">
      <Setter Property="Background" Value="#131820D9" />
      <Setter Property="BorderBrush" Value="#FFFFFF18" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="7,4" />
    </Style>
    <Style Selector="Border.resource-badge TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#DDE4EE" />
    </Style>

    <Style Selector="ToggleButton.filter-header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#D9DEE7" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="7,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="ToggleButton.filter-header:pointerover">
      <Setter Property="Background" Value="#181E27" />
    </Style>
    <Style Selector="ToggleButton.filter-header:checked">
      <Setter Property="Background" Value="#1B222C" />
      <Setter Property="Foreground" Value="#F0F3F7" />
    </Style>
    <Style Selector="CheckBox.filter-option">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#C2CAD6" />
      <Setter Property="Padding" Value="4,4" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox.filter-option:pointerover">
      <Setter Property="Background" Value="#171D26" />
      <Setter Property="Foreground" Value="#E8ECF2" />
    </Style>
    <Style Selector="CheckBox.filter-option:pressed">
      <Setter Property="Background" Value="#1B222C" />
    </Style>
    <Style Selector="Button.filter-reset">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#8F98A8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Button.filter-reset:pointerover">
      <Setter Property="Background" Value="#1B222C" />
      <Setter Property="Foreground" Value="#D9DEE7" />
    </Style>

    <Style Selector="Border.danger-zone">
      <Setter Property="Background" Value="#1A1519" />
      <Setter Property="BorderBrush" Value="#7A3A43" />
      <Setter Property="BorderThickness" Value="0,0,0,0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Border.busy-overlay">
      <Setter Property="Background" Value="#D90F1217" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="ProgressBar.animated-progress">
      <Setter Property="Foreground" Value="#4CD97B" />
      <Setter Property="Background" Value="#242A32" />
    </Style>
  </Application.Styles>
</Application>
